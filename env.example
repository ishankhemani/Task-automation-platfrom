# Node Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_automation_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_automation_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# BullMQ Queue Configuration
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_STALLED_COUNT=2

# Socket.IO & CORS
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ACCESS_SECRET=super-secret-jwt-access-token-key-change-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-token-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=
